{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "src/app/api/figma/render-batch/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/miro/update-image/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/penpot-(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
